{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["ESNext"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "5.0",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/bus/*": ["./src/bus/*"],
      "@/constants/*": ["./src/constants/*"],
      "@/types/*": ["./src/types/*"],
      "@/parser/*": ["./src/parser/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/service/*": ["./src/service/*"],
      "@/gateway/*": ["./src/gateway/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "src/**/*.test.ts"]
}
