{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["ESNext"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "5.0",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@orchestration/bus-types": ["../bus-types/src/index.ts"],
      "@/entities/*": ["./src/entities/*"],
      "@/bus/*": ["./src/bus/*"],
      "@/types/*": ["./src/types/*"],
      "@/parser/*": ["./src/parser/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/service/*": ["./src/service/*"],
      "@/orchestrate/*": ["./src/orchestrate/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "src/**/*.test.ts"]
}
