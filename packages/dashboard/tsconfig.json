{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "ignoreDeprecations": "5.0",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/types/plan": [
        "../orchestration-runtime/src/types/plan.ts"
      ],
      "@/types/waterfall": [
        "../orchestration-runtime/src/types/waterfall.ts"
      ],
      "@/bus/*": [
        "../orchestration-runtime/src/bus/*"
      ],
      "@/lib/query-client": [
        "./src/lib/query-client.ts"
      ],
      "@/lib/utils": [
        "./src/lib/utils.ts"
      ],
      "@/lib/*": [
        "../orchestration-runtime/src/lib/*"
      ],
      "@/service/*": [
        "../orchestration-runtime/src/service/*"
      ],
      "@/parser/*": [
        "../orchestration-runtime/src/parser/*"
      ],
      "@/gateway/*": [
        "../orchestration-runtime/src/gateway/*"
      ],
      "@/constants/*": [
        "../orchestration-runtime/src/constants/*"
      ],
      "@/*": [
        "./src/*"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
