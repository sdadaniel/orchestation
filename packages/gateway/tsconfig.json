{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@orchestration/bus-types": ["../bus-types/src/index.ts"],
      "@gateway/*": ["./src/*"],
      "@runtime/*": ["../engine/src/*"],
      "@/entities/*": ["../engine/src/entities/*"],
      "@/orchestrate/*": ["../engine/src/orchestrate/*"],
      "@/bus/*":     ["../engine/src/bus/*"],
      "@/lib/*":     ["../engine/src/lib/*"],
      "@/service/*": ["../engine/src/service/*"],
      "@/constants/*": ["../engine/src/constants/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
